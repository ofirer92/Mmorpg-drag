{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat PROGRESS.md && echo '--- OPEN TASKS ---' && grep -n '\\[ \\]' TASKS.md | head -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "scripts/hooks/guard_protected.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "scripts/hooks/guard_bash.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "scripts/hooks/format_and_lint.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "scripts/hooks/on_stop.sh" }]
      }
    ]
  }
}
